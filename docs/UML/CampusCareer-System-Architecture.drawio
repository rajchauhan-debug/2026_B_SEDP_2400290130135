        <mxCell id="design_note" value="&lt;b&gt;Design choices:&lt;/b&gt; The frontend never connects directly to MongoDB. Authentication, authorization, input validation and duplicate-application rules are checked by the backend. A single Express backend is enough for the current project; microservices are not required." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#334155;fontSize=12;spacing=7;" vertex="1" parent="1">
